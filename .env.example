# Compose local-only password. Use a URL-safe value; ports bind to loopback.
POSTGRES_PASSWORD=sqsp-local-only

# Native development: set these in the current shell before launching API and worker.
SQSP_DATABASE_URL=sqlite:///./data/sqsp.db
SQSP_QUEUE_BACKEND=database
SQSP_REDIS_URL=redis://127.0.0.1:6379/0
SQSP_ARTIFACT_ROOT=./data/artifacts
